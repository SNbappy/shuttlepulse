# ============================================================================
# ShuttlePulse — Deployment & Mobile App Environment Configuration
# Copy this file to `.env.local` and fill in your keys at deployment time.
# ============================================================================

# 1. Supabase Database & Backend (https://supabase.com/dashboard)
# Run `supabase/schema.sql` in the Supabase SQL Editor to create all tables.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# 2. ImgBB Image Hosting API Key (https://api.imgbb.com/)
# Used for uploading & drag-and-dropping member profile photos to ImgBB cloud.
NEXT_PUBLIC_IMGBB_API_KEY=your_imgbb_api_key_here
IMGBB_API_KEY=your_imgbb_api_key_here

# 3. Brevo (Sendinblue) Transactional Email API (https://app.brevo.com/)
# Used for sending 6-digit account verification OTP emails during registration.
NEXT_PUBLIC_BREVO_API_KEY=your_brevo_api_key_here
BREVO_API_KEY=your_brevo_api_key_here
NEXT_PUBLIC_BREVO_SENDER_EMAIL=no-reply@shuttlepulse.com
BREVO_SENDER_EMAIL=no-reply@shuttlepulse.com
NEXT_PUBLIC_BREVO_SENDER_NAME=ShuttlePulse Badminton Club
BREVO_SENDER_NAME=ShuttlePulse Badminton Club
